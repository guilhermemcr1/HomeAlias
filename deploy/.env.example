# Gere cada segredo com: openssl rand -hex 32   (o backend recusa os valores de exemplo)
HOMEALIAS_ENCRYPTION_KEY=
HOMEALIAS_SESSION_KEY=

# Conta admin criada no primeiro start (só se ainda não houver admin). Mínimo 12 caracteres, nada comum.
HOMEALIAS_ADMIN_EMAIL=
HOMEALIAS_ADMIN_PASSWORD=

# MariaDB do host (veja deploy/sql/create-db.sql.example). Use 127.0.0.1: o backend roda em network_mode host.
DATABASE_DSN=homealias:SENHA_DO_BANCO@tcp(127.0.0.1:3306)/homealias?parseTime=true

# Produção atrás do Cloudflare Tunnel: escuta só em localhost; o cloudflared aponta para http://localhost:8080.
HOMEALIAS_BIND_IP=127.0.0.1
HOMEALIAS_PORT=8080
COOKIE_SECURE=true
TRUST_CLOUDFLARE_HEADERS=true
# Para testar pela LAN em HTTP (somente desenvolvimento): HOMEALIAS_BIND_IP=0.0.0.0, COOKIE_SECURE=false,
# TRUST_CLOUDFLARE_HEADERS=false (senão qualquer um na rede forja o IP via CF-Connecting-IP).

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
